{
  "name": "storysketch",
  "version": "0.21.0",
  "description": "Pose stick figures and props, layer them, and export them in a hand-drawn style (crayon, marker, ink, chalk).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "serve": "python3 -m http.server 8765",
    "build:plugins": "python3 tools/build_plugins.py",
    "check:plugins": "python3 tools/build_plugins.py --check",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test:visual": "node --test tests/e2e/visual.test.mjs",
    "update:baselines": "node tools/update_baselines.mjs",
    "test:all": "npm run check:plugins && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "playwright-core": "^1.50.0"
  }
}
